# MaxBot environment template.
#
# Copy this file to `.env` (in the same directory as the Tauri
# `Cargo.toml`) and fill in the values you want MaxBot to pick up
# on first launch. Settings from this file are only seeded into
# the SQLite settings row when the corresponding field is empty —
# once you set a value through the Settings UI, that value wins.
#
# Recognized keys (parsed by src-tauri/src/env_loader.rs and
# applied by seed_settings_from_env in src-tauri/src/lib.rs):
#
#   MINIMAX_API_KEY        → Settings::minimax_api_key
#   OPENAI_API_KEY         → Settings::openai_api_key
#   ANTHROPIC_API_KEY      → Settings::anthropic_api_key
#   XAI_API_KEY            → Settings::xai_api_key
#   SAND_MINIMAX_BASE_URL  → Settings::minimax_base_url
#   SAND_MINIMAX_MODEL     → Settings::default_model
#   MAXBOT_PROVIDER        → Settings::provider_kind
#   MAXBOT_TTS_VOICE       → Settings::tts_voice
#   MAXBOT_GROK_BUILD_BINARY → Settings::grok_build_binary
#   MAXBOT_GROK_BUILD_MODEL  → Settings::grok_build_model
#   MAXBOT_GROK_CWD          → Settings::grok_cwd
#
# The env loader also looks at $MAXBOT_ENV (a full path to a .env
# file) before any of the candidate locations — handy for pointing
# MaxBot at a per-workspace env without symlinking.
# LLM provider API keys. Pick at least one and remove the others,
# or set all four and switch between them from the Settings UI.
# MiniMax (default). Find it at https://minimax.io → API Keys.
MINIMAX_API_KEY=eyJ...

# OpenAI. platform.openai.com → API keys.
OPENAI_API_KEY=sk-...

# Anthropic. console.anthropic.com → Settings → API Keys.
ANTHROPIC_API_KEY=sk-ant-...

# xAI. console.x.ai → API Keys.
XAI_API_KEY=xai-...

# Optional: override the MiniMax endpoint. The default
# (https://api.minimax.io/v1) hits the international cluster; set
# this to a self-hosted proxy or alternate region endpoint if
# needed. Leave commented out to use the built-in default.
# SAND_MINIMAX_BASE_URL=https://api.minimax.io/v1

# Optional: override the default model id for the active provider.
# Each provider preset has its own default (MiniMax-M3, gpt-4o,
# claude-3-5-sonnet-latest, grok-2-latest) which is used when this
# value is empty.
# SAND_MINIMAX_MODEL=MiniMax-M3

# Optional: pick the active LLM provider on first launch. One of
# `minimax` (default), `openai`, `anthropic`, `xai`. Unknown
# values fall back to `minimax`.
# MAXBOT_PROVIDER=minimax

# Optional: TTS voice passed to `say -v`. Leave blank for
# `Samantha` (high-quality en-US, ships with every macOS install).
# Run `say -v ?` in Terminal to list installed voices.
# MAXBOT_TTS_VOICE=Samantha

# Optional: path to the `grok` CLI binary the `grok_prompt` tool
# spawns. Leave blank to resolve `grok` on $PATH. If your install
# lives elsewhere (e.g. ~/.grok/bin/grok), set the absolute path.
# MAXBOT_GROK_BUILD_BINARY=grok

# Optional: model alias passed to `grok --model <alias>`. Resolved
# via the `[model.<alias>]` table in ~/.grok/config.toml. The
# default `minimax` is the alias the official install uses for the
# MiniMax provider.
# MAXBOT_GROK_BUILD_MODEL=minimax

# Optional: working directory for the `grok agent stdio`
# subprocess. Leave blank to use the per-app data dir's `grok/`
# subfolder; set to an absolute path to point the agent at a
# specific project.
# MAXBOT_GROK_CWD=

# --- Per-Bot Linux computer (v2.0) ---
# Optional: override MaxBot's Settings → Computer fields from the
# environment on first launch. Once a value is set through the
# Settings UI, that value wins (the env var is only the seed).
#
# Recognized keys (parsed by src-tauri/src/env_loader.rs):
#
#   MAXBOT_COMPUTER_SERVER_HOST         → Settings::computer_server_host
#   MAXBOT_COMPUTER_SERVER_SSH_USER     → Settings::computer_server_ssh_user
#   MAXBOT_COMPUTER_VNC_PORT_RANGE      → Settings::computer_vnc_local_port_range
#                                         (e.g. "5900-5999")
#   MAXBOT_COMPUTER_PASSPHRASE          → Settings::computer_passphrase
#   MAXBOT_COMPUTER_DEFAULT_DISK_GB     → Settings::computer_default_disk_gb
#   MAXBOT_COMPUTER_DEFAULT_RAM_MB      → Settings::computer_default_ram_mb
#
# Example:
# MAXBOT_COMPUTER_SERVER_HOST=192.168.0.49
# MAXBOT_COMPUTER_SERVER_SSH_USER=tyler
# MAXBOT_COMPUTER_VNC_PORT_RANGE=5900-5999
# MAXBOT_COMPUTER_PASSPHRASE=
# MAXBOT_COMPUTER_DEFAULT_DISK_GB=10
# MAXBOT_COMPUTER_DEFAULT_RAM_MB=2048
